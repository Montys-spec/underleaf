{
  "name": "underleaf",
  "productName": "Underleaf",
  "version": "0.2.0",
  "description": "A local, Overleaf-style LaTeX editor for macOS",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "build": "npm run native && electron-vite build",
    "dev": "npm run native && electron-vite dev",
    "dist": "npm run build && electron-builder --mac --publish never",
    "native": "sh scripts/build-native.sh && sh scripts/fetch-texlab.sh",
    "package": "npm run build && electron-builder --mac dir",
    "start": "npm run build && electron-vite preview",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/*.test.mts",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/lsp-client": "^6.3.0",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  },
  "allowScripts": {
    "electron@45.0.0": true,
    "fsevents@2.3.3": true
  },
  "author": "Monty",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Montys-spec/underleaf.git"
  }
}
